# =============================================================================
# BookItMalta — Environment variables
# =============================================================================
#
# IMPORTANT: This file is committed to git. NEVER put real secrets here.
# The placeholder values below are deliberately formatted to NOT match
# GitHub's secret-scanning patterns. Real secrets live in Vercel env vars.
#
# Naming convention: per-tenant secrets are prefixed by the tenant slug
# (UPPER_CASE, hyphens → underscores). This lets one Vercel project host
# multiple tenants safely — there's no way to cross the wires.
#
# Shared (non-tenant):
#   RESEND_API_KEY              — single Resend account across all tenants
#
# Per-tenant (replicate for each new tenant by changing the prefix):
#   BANDAMA_SUPABASE_URL
#   BANDAMA_SUPABASE_SERVICE_ROLE_KEY
#   BANDAMA_STRIPE_SECRET_KEY
#   BANDAMA_STRIPE_WEBHOOK_SECRET
#   BANDAMA_OPERATOR_EMAIL
#   BANDAMA_RESEND_FROM          (optional — defaults to noreply@bookitmalta.com)
#   BANDAMA_PUBLIC_BASE_URL      (optional — defaults to https://bookitmalta.com)
#
# Set these in Vercel: Project Settings → Environment Variables.
# Service-role keys and Stripe secret keys must ONLY be present in
# Production + Preview envs, and NEVER exposed via NEXT_PUBLIC_* or any
# client bundle.

# -----------------------------------------------------------------------------
# Shared
# -----------------------------------------------------------------------------
RESEND_API_KEY=YOUR_RESEND_API_KEY

# -----------------------------------------------------------------------------
# Tenant: bandama
# -----------------------------------------------------------------------------
# Supabase Project URL is not secret (public-readable) — copy from
# Supabase dashboard → Project Settings → API → Project URL
BANDAMA_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — copy from Supabase dashboard → Project Settings → API
# → service_role secret. NEVER expose client-side.
BANDAMA_SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Stripe live secret key — from Stripe Dashboard → Developers → API keys
BANDAMA_STRIPE_SECRET_KEY=YOUR_STRIPE_LIVE_SECRET_KEY

# Stripe webhook signing secret — from Stripe Dashboard → Developers →
# Webhooks → your endpoint → Signing secret
BANDAMA_STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

BANDAMA_OPERATOR_EMAIL=info@bandamacharters.com
BANDAMA_RESEND_FROM=Bandama Yacht Charters <noreply@bookitmalta.com>
BANDAMA_PUBLIC_BASE_URL=https://bookitmalta.com

# -----------------------------------------------------------------------------
# Tenant: adventure-cruises (TBC — fill once operator confirmed)
# -----------------------------------------------------------------------------
# ADVENTURE_CRUISES_SUPABASE_URL=
# ADVENTURE_CRUISES_SUPABASE_SERVICE_ROLE_KEY=
# ADVENTURE_CRUISES_STRIPE_SECRET_KEY=
# ADVENTURE_CRUISES_STRIPE_WEBHOOK_SECRET=
# ADVENTURE_CRUISES_OPERATOR_EMAIL=info@adventurecruisesmalta.com
# ADVENTURE_CRUISES_RESEND_FROM=
# ADVENTURE_CRUISES_PUBLIC_BASE_URL=
