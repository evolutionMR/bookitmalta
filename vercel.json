{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/admin/*.js": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/charters", "destination": "/", "permanent": true },
    { "source": "/charters/", "destination": "/", "permanent": true },
    { "source": "/charters/adventure-cruises", "destination": "/adventure-cruises", "permanent": true },
    { "source": "/charters/adventure-cruises/", "destination": "/adventure-cruises", "permanent": true },
    { "source": "/config/:path*", "destination": "/", "permanent": false },
    { "source": "/db/:path*", "destination": "/", "permanent": false },
    { "source": "/docs/:path*", "destination": "/", "permanent": false },
    { "source": "/scripts/:path*", "destination": "/", "permanent": false },
    { "source": "/README.md", "destination": "/", "permanent": false },
    { "source": "/HANDOFF.md", "destination": "/", "permanent": false },
    { "source": "/ENGINE-SETUP.md", "destination": "/", "permanent": false },
    { "source": "/BUILD_INSTRUCTIONS.md", "destination": "/", "permanent": false },
    { "source": "/CHANGELOG.md", "destination": "/", "permanent": false },
    { "source": "/CLAUDE.md", "destination": "/", "permanent": false },
    { "source": "/.env.example", "destination": "/", "permanent": false },
    { "source": "/package.json", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/captain/login",     "destination": "/captain/login.html" },
    { "source": "/captain/dashboard", "destination": "/captain/dashboard.html" },
    { "source": "/captain/:path*", "destination": "/api/captain" },
    { "source": "/for-operators", "destination": "/for-operators.html" },
    { "source": "/for-operators/intake", "destination": "/for-operators/intake.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/adventure-cruises", "destination": "/adventure-cruises.html" },
    { "source": "/charters/unexpected-charters-malta", "destination": "/charters/unexpected-charters-malta.html" },
    { "source": "/catamaran", "destination": "/catamaran.html" },
    { "source": "/booking-confirmed", "destination": "/booking-confirmed.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
